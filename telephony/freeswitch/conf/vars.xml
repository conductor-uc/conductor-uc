<include>
  <!--
      S1-10: every deployment-specific value here has a default plus an
      `env-set` override, so the same image runs in compose and in any real
      deployment without a config-file edit — only environment variables
      change (09 §1's convention for services, applied to this node too).

      `env-set` only overrides when the named OS environment variable is
      actually present; the preceding `set` is what makes that safe to skip.
  -->

  <!-- 02 §5.5: the SIP User-Agent header's identity string. Functional, not
       a product or vendor name. -->
  <X-PRE-PROCESS cmd="set" data="sip_identity=SIP Media Server"/>
  <X-PRE-PROCESS cmd="env-set" data="sip_identity=$FS_SIP_IDENTITY"/>

  <!-- The SDP o=/s= line's username token (`sip_profiles/internal.xml`'s
       own `username` param) — a *different* value from `sip_identity`
       above on purpose: RFC 4566's o= line grammar requires this field to
       be a single token with no embedded whitespace ("The username MUST
       NOT contain spaces"), but `sip_identity`'s neutral value has one.
       Confirmed directly this is not merely cosmetic: reusing
       `sip_identity` here made sofia-sip's own outbound message
       construction fail internally (`nua_client.c`'s `sip_object(msg)`
       returning NULL, reported as "900 Internal error") for *every*
       outbound INVITE this node ever originates, before any packet is
       sent — S1-10's own "Done when" never exercised an outbound call, so
       this went uncaught until S1-14 first tried one. -->
  <X-PRE-PROCESS cmd="set" data="sip_sdp_identity=SIP-Media-Server"/>
  <X-PRE-PROCESS cmd="env-set" data="sip_sdp_identity=$FS_SDP_IDENTITY"/>

  <!-- No per-tenant meaning at the node level (02 §3): every domain/user
       lookup is dynamic, via xml_curl — see autoload_configs/xml_curl.conf.xml.
       This is only the fallback FreeSWITCH falls back to if a lookup never
       names one. -->
  <X-PRE-PROCESS cmd="set" data="domain=$${local_ip_v4}"/>

  <X-PRE-PROCESS cmd="set" data="internal_sip_port=5060"/>
  <X-PRE-PROCESS cmd="env-set" data="internal_sip_port=$FS_SIP_PORT"/>

  <!-- 03 §1: media never leaves the docker/cluster network directly — OpenSIPs
       is the only thing FS ever talks to, and it owns NAT/external exposure
       (RTPengine media anchoring is deferred, O-7). No STUN lookup needed. -->
  <X-PRE-PROCESS cmd="set" data="external_rtp_ip=$${local_ip_v4}"/>
  <X-PRE-PROCESS cmd="set" data="external_sip_ip=$${local_ip_v4}"/>

  <X-PRE-PROCESS cmd="set" data="rtp_start_port=16384"/>
  <X-PRE-PROCESS cmd="env-set" data="rtp_start_port=$FS_RTP_START_PORT"/>
  <X-PRE-PROCESS cmd="set" data="rtp_end_port=32768"/>
  <X-PRE-PROCESS cmd="env-set" data="rtp_end_port=$FS_RTP_END_PORT"/>

  <!-- 03 §1: "FS accepts calls only from OpenSIPs addresses (a Sofia ACL)" —
       see autoload_configs/acl.conf.xml. The default denies everything, so a
       deployment that forgets to set this fails closed, not open. -->
  <X-PRE-PROCESS cmd="set" data="opensips_cidr=127.0.0.1/32"/>
  <X-PRE-PROCESS cmd="env-set" data="opensips_cidr=$FS_OPENSIPS_CIDR"/>

  <!-- Gates the event socket (autoload_configs/acl.conf.xml's "cluster"
       list) — the private cluster/orchestrator network call-control (S2+)
       reaches this node from. Same fail-closed default as opensips_cidr. -->
  <X-PRE-PROCESS cmd="set" data="cluster_cidr=127.0.0.1/32"/>
  <X-PRE-PROCESS cmd="env-set" data="cluster_cidr=$FS_CLUSTER_CIDR"/>

  <!-- 03 §3: "Event socket listens on a private interface." call-control
       (S2+) connects inbound to every node; nothing does yet. Bound to all
       interfaces inside the container (0.0.0.0) rather than a specific one
       — the container's network namespace is already private, and access is
       actually restricted by the "cluster" ACL below, not by bind address
       (mod_event_socket falls back to a loopback-only ACL when none is
       configured at all, which a non-loopback bind address would fail —
       explicit is more robust than relying on that fallback). No safe
       default password exists, so this one is deliberately obviously a
       placeholder — every real deployment MUST set FS_EVENT_SOCKET_PASSWORD. -->
  <X-PRE-PROCESS cmd="set" data="event_socket_bind_ip=0.0.0.0"/>
  <X-PRE-PROCESS cmd="env-set" data="event_socket_bind_ip=$FS_EVENT_SOCKET_BIND_IP"/>
  <X-PRE-PROCESS cmd="set" data="event_socket_password=change-me-FS_EVENT_SOCKET_PASSWORD"/>
  <X-PRE-PROCESS cmd="env-set" data="event_socket_password=$FS_EVENT_SOCKET_PASSWORD"/>

  <!-- 03 §3.1 / D-006: telephony-config's xml_curl endpoints. Gated by network
       ACL plus this shared token (07 §1's precedent for FS/OpenSIPs — real
       service-to-service auth does not exist yet), presented as HTTP basic
       auth (gateway-credentials, below). -->
  <X-PRE-PROCESS cmd="set" data="telephony_config_url=http://telephony-config:8080"/>
  <X-PRE-PROCESS cmd="env-set" data="telephony_config_url=$TELEPHONY_CONFIG_URL"/>
  <X-PRE-PROCESS cmd="set" data="telephony_config_token=change-me-FS_XML_CURL_TOKEN"/>
  <X-PRE-PROCESS cmd="env-set" data="telephony_config_token=$FS_XML_CURL_TOKEN"/>

  <!-- S2-18: cdr-service's `POST /ingest/json-cdr` (`mod_json_cdr.conf.xml`'s
       own `cred` param reads these) — same shared-token-as-basic-auth
       mechanism as telephony_config_url/token above, a distinct pair
       because this is a different service's own gate. -->
  <X-PRE-PROCESS cmd="set" data="cdr_service_url=http://cdr-service:8080"/>
  <X-PRE-PROCESS cmd="env-set" data="cdr_service_url=$CDR_SERVICE_URL"/>
  <X-PRE-PROCESS cmd="set" data="cdr_service_token=change-me-FS_CDR_INGEST_TOKEN"/>
  <X-PRE-PROCESS cmd="env-set" data="cdr_service_token=$FS_CDR_INGEST_TOKEN"/>

  <!-- S2-12 (04 §3.3): this node's own affinity identity — must be the same
       id call-control's own `FS_NODES` config names this node by (`id:host:
       port` triples), since that id is what ends up as an `aff:{tenantId}:
       {kind}:{resourceId}` lease's value. `flow_runner.lua`'s `resolveAffinity`/
       `hairpinTransfer` read this the same way `telephony_config_url`/
       `telephony_config_token` above already are: a global var, not a
       per-call channel `set`, since it is about the node, not the call.
       No safe default: every real deployment MUST set FS_NODE_ID to
       something call-control's own FS_NODES agrees on. -->
  <X-PRE-PROCESS cmd="set" data="cuc_node_id=change-me-FS_NODE_ID"/>
  <X-PRE-PROCESS cmd="env-set" data="cuc_node_id=$FS_NODE_ID"/>

  <X-PRE-PROCESS cmd="set" data="console_loglevel=info"/>
  <X-PRE-PROCESS cmd="env-set" data="console_loglevel=$FS_LOG_LEVEL"/>

  <!-- Codec preference (03 §3): Opus first, G.711/G.722 as the interoperable
       fallback. No video codec here — mod_vpx is not in the module set this
       image ships (M1 is audio-only; video arrives with S6-01). -->
  <X-PRE-PROCESS cmd="set" data="global_codec_prefs=OPUS,G722,PCMU,PCMA"/>
  <X-PRE-PROCESS cmd="set" data="outbound_codec_prefs=OPUS,G722,PCMU,PCMA"/>

  <!-- 06's recording pipeline: FS spools here (tmpfs — see the Dockerfile and
       compose's volume mount), and a node-local uploader sidecar (a later
       stage) pushes to S3 and deletes the local copy. Nothing durable lives
       on the node (CLAUDE.md rule 5). -->
  <X-PRE-PROCESS cmd="set" data="recordings_dir=/var/spool/cuc/rec"/>

  <!-- S2-05: `mod_redis` (autoload_configs/redis.conf.xml) — the shared
       counter `xml.ts`'s `buildOutboundDialplanDocument` writes a per-tenant
       `limit` action for, via the "redis" backend. Defaults match this
       repo's own compose service name/port directly (same convention
       `OPENSIPS_REDIS_URL`'s own default already uses) since, unlike a
       password, there's no unsafe default to avoid here. -->
  <X-PRE-PROCESS cmd="set" data="fs_redis_host=redis"/>
  <X-PRE-PROCESS cmd="env-set" data="fs_redis_host=$FS_REDIS_HOST"/>
  <X-PRE-PROCESS cmd="set" data="fs_redis_port=6379"/>
  <X-PRE-PROCESS cmd="env-set" data="fs_redis_port=$FS_REDIS_PORT"/>
</include>
