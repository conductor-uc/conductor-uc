# S4-11: the settings every server of a deployment shares (docs/architecture/
# 10-production-topology.md). Copy to /opt/voice/platform.env on EVERY server,
# identical; each server then adds only its own identity in /opt/voice/.env
# (see README.md). Secrets: generate each once (`openssl rand -hex 32`) and
# keep this file readable by root only.

# ---------------------------------------------------------------- release
IMAGE_REGISTRY=ghcr.io/conductor-uc
RELEASE=0.9.0

# ---------------------------------------------------------------- addresses
# Edge pair (public addresses, where phones, carriers and browsers connect)
EDGE1_IP=10.10.0.11
EDGE2_IP=10.10.0.12
# The edge pair's public floating address (keepalived, or the provider's).
EDGE_VIP=10.10.0.100
# The edge pair's private floating address the media servers send RTP to.
EDGE_MEDIA_VIP=10.10.0.101
# App pair: the services, and the internal load balancer every client uses.
APP1_IP=10.10.0.21
APP2_IP=10.10.0.22
APP_VIP=10.10.0.102
# Data servers: Galera, Redis with Sentinel, NATS.
DATA1_IP=10.10.0.31
DATA2_IP=10.10.0.32
DATA3_IP=10.10.0.33
# Media servers, in the two forms their clients take (comma-separated, one entry
# per server, the same ids in both). To add one, add it to both, then restart
# the edges (dispatcher) and call-control on the app servers (event sockets).
MEDIA_DISPATCHER=fs1=sip:10.10.0.41:5080
MEDIA_EVENT_SOCKETS=fs1:10.10.0.41:8021
# The private network every server is on (FreeSWITCH's ACLs).
PRIVATE_CIDR=10.10.0.0/24
# Netmask length of the floating addresses on their interface.
VIP_PREFIX=24

# ---------------------------------------------------------------- platform
PLATFORM_BASE_DOMAIN=voice.example.com
SIP_IDENTITY=SIP Media Server

# ---------------------------------------------------------------- secrets
MARIADB_ROOT_PASSWORD=change-me
GALERA_MONITOR_PASSWORD=change-me
IDENTITY_SERVICE_DB_PASSWORD=change-me
ORG_SERVICE_DB_PASSWORD=change-me
PBX_CONFIG_SERVICE_DB_PASSWORD=change-me
EXAMPLE_SERVICE_DB_PASSWORD=change-me
TELEPHONY_CONFIG_SERVICE_DB_PASSWORD=change-me
TRUNK_SERVICE_DB_PASSWORD=change-me
MEDIA_WORKER_DB_PASSWORD=change-me
CALL_CONTROL_DB_PASSWORD=change-me
CALLFLOW_SERVICE_DB_PASSWORD=change-me
VOICEMAIL_SERVICE_DB_PASSWORD=change-me
CDR_SERVICE_DB_PASSWORD=change-me
NOTIFICATION_SERVICE_DB_PASSWORD=change-me
RECORDING_SERVICE_DB_PASSWORD=change-me
OPENSIPS_DB_PASSWORD=change-me
NATS_USER=voice
NATS_PASSWORD=change-me
INTERNAL_SERVICE_TOKEN=change-me
INTERNAL_HEADER_SIGNING_SECRET=change-me
FS_XML_CURL_TOKEN=change-me
FS_CDR_INGEST_TOKEN=change-me
FS_EVENT_SOCKET_PASSWORD=change-me
# `CRYPTO_KEKS`: printf "1:%s" "$(openssl rand -base64 32)" (configuration-reference §3.5).
CRYPTO_KEKS=1:change-me-44-base64-characters
CRYPTO_KEK_CURRENT=1
PROVISIONING_USERNAME=provision
PROVISIONING_PASSWORD=change-me

# ---------------------------------------------------------------- object storage
STORAGE_BUCKET_PREFIX=voice
STORAGE_ENDPOINT=https://s3.example.com
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY_ID=change-me
STORAGE_SECRET_ACCESS_KEY=change-me
STORAGE_FORCE_PATH_STYLE=false
STORAGE_ORIGIN=https://s3.example.com

# ---------------------------------------------------------------- email
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=change-me
SMTP_PASSWORD=change-me
PLATFORM_NOREPLY_ADDRESS=noreply@voice.example.com
