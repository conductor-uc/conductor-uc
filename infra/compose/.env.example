# Copy to `.env` in this directory (or `cp .env.example .env`) and adjust if
# something on your laptop already owns one of the default ports. Never commit
# `.env` — see the root `.gitignore`.

# --- MariaDB --------------------------------------------------------------
MARIADB_PORT=3306
MARIADB_ROOT_PASSWORD=dev-root-password

# Per-service DB users this stack provisions on first boot (05 §1.1: one
# schema, one user, grants only on its own schema). Add a line here — and a
# matching block in mariadb/init/01-schemas.sql — for every new service.
IDENTITY_SERVICE_DB_PASSWORD=dev-identity-password
ORG_SERVICE_DB_PASSWORD=dev-org-password
EXAMPLE_SERVICE_DB_PASSWORD=dev-example-password

# --- Redis ------------------------------------------------------------------
REDIS_PORT=6379

# --- NATS (JetStream) ---------------------------------------------------
NATS_PORT=4222
NATS_MONITOR_PORT=8222

# --- MinIO (S3-compatible) -----------------------------------------------
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=dev-minio
MINIO_ROOT_PASSWORD=dev-minio-password

# --- Mailpit (SMTP catcher) -----------------------------------------------
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
