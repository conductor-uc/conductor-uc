<?xml version="1.0" encoding="ISO-8859-1"?>
<!DOCTYPE scenario SYSTEM "sipp.dtd">
<!--
  `answer_call.xml`, except that the answer offers RFC 2833 DTMF
  (`telephone-event`), as a real phone does. A caller's DTMF that FreeSWITCH
  relays to this leg then travels in RTP, which SIPp ignores. Without it,
  FreeSWITCH can only relay DTMF as SIP INFO, which `answer_call.xml` does not
  expect (found live: S5-13's "*1 does nothing where no rule allows it", where
  the digits are not captured and so are passed on, as they should be).
-->
<scenario name="Answer one call, offering RFC 2833 DTMF">
  <recv request="INVITE" crlf="true" timeout="60000">
  </recv>

  <send>
    <![CDATA[
      SIP/2.0 180 Ringing
      [last_Via:]
      [last_From:]
      [last_To:];tag=[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:[field0]@[local_ip]:[local_port]>
      Content-Length: 0
    ]]>
  </send>

  <send retrans="500">
    <![CDATA[
      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:];tag=[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:[field0]@[local_ip]:[local_port]>
      Content-Type: application/sdp
      Content-Length: [len]

      v=0
      o=- [call_number] [call_number] IN IP4 [local_ip]
      s=-
      c=IN IP4 [local_ip]
      t=0 0
      m=audio [media_port] RTP/AVP 0 101
      a=rtpmap:0 PCMU/8000
      a=rtpmap:101 telephone-event/8000
      a=fmtp:101 0-16
    ]]>
  </send>

  <recv request="ACK" rtd="true" crlf="true">
  </recv>

  <recv request="BYE" crlf="true" timeout="60000">
  </recv>

  <send>
    <![CDATA[
      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:]
      [last_Call-ID:]
      [last_CSeq:]
      Content-Length: 0
    ]]>
  </send>

</scenario>
