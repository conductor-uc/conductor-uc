# Copy to `.env` in this directory (`make up` does it when `.env` is missing)
# and adjust if something on your laptop already owns one of the default ports.
# Never commit `.env` — see the root `.gitignore`. Every value here is also the
# default in docker-compose.yml, and is for a laptop only.

# --- MariaDB --------------------------------------------------------------
MARIADB_PORT=3306
MARIADB_ROOT_PASSWORD=dev-root-password

# Per-service DB users this stack provisions on first boot (05 §1.1: one
# schema, one user, grants only on its own schema). Add a line here — and a
# matching `create_service_db` call in mariadb/init/01-schemas.sh — for every
# new service.
IDENTITY_SERVICE_DB_PASSWORD=dev-identity-password
ORG_SERVICE_DB_PASSWORD=dev-org-password
PBX_CONFIG_SERVICE_DB_PASSWORD=dev-pbx-config-password
EXAMPLE_SERVICE_DB_PASSWORD=dev-example-password
TELEPHONY_CONFIG_SERVICE_DB_PASSWORD=dev-telephony-config-password
TRUNK_SERVICE_DB_PASSWORD=dev-trunk-service-password
MEDIA_WORKER_DB_PASSWORD=dev-media-worker-password
CALL_CONTROL_DB_PASSWORD=dev-call-control-password
CALLFLOW_SERVICE_DB_PASSWORD=dev-callflow-service-password
VOICEMAIL_SERVICE_DB_PASSWORD=dev-voicemail-service-password
CDR_SERVICE_DB_PASSWORD=dev-cdr-service-password
NOTIFICATION_SERVICE_DB_PASSWORD=dev-notification-service-password
RECORDING_SERVICE_DB_PASSWORD=dev-recording-service-password
# Not a Node service, but provisioned the same way — see 01-schemas.sh.
OPENSIPS_DB_PASSWORD=dev-opensips-password

# --- Redis ------------------------------------------------------------------
REDIS_PORT=6379

# --- NATS (JetStream) ---------------------------------------------------
NATS_PORT=4222
NATS_MONITOR_PORT=8222

# --- MinIO (S3-compatible) -----------------------------------------------
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=dev-minio
MINIO_ROOT_PASSWORD=dev-minio-password

# --- Mailpit (SMTP catcher) -----------------------------------------------
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# --- Platform ---------------------------------------------------------------
# The platform base domain: sip.<domain>, console.<domain>, and a tenant's
# fallback domain. Keep OPENSIPS_TLS_DEV_NAMES below in step with it.
PLATFORM_BASE_DOMAIN=platform.test
# Service-to-service token for internal routes (identity's admin-user route,
# certificates, affinity, recording uploads).
INTERNAL_SERVICE_TOKEN=dev-internal-service-token
# Envelope-encryption key set, `<version>:<base64 of 32 bytes>` (comma-separated
# for more than one), and the version new data is encrypted with. Dev-only key
# (packages/crypto/src/config.ts); a real deployment keeps its own elsewhere.
CRYPTO_KEKS=1:u4SpMlDTAL6cVMC2rzCxhoKCRAJxpgoc7h+hX3OfdfY=
CRYPTO_KEK_CURRENT=1

# --- Email (notification-service, S3-03) -------------------------------------
PLATFORM_NOREPLY_ADDRESS=noreply@local.test
# Links in emails point at <scheme>://console.$PLATFORM_BASE_DOMAIN, or at
# CONSOLE_URL_OVERRIDE when set (a console served somewhere else).
CONSOLE_LINK_SCHEME=http
# CONSOLE_URL_OVERRIDE=http://localhost:8099

# --- Development administrator (`make seed`, G-115) -------------------------
# seed.sh creates the master org and this master administrator with
# bootstrap-master (the password goes in as BOOTSTRAP_ADMIN_PASSWORD, never as
# an argument). At least 12 characters. At sign-in a master administrator is
# asked to set up two-step verification first.
DEV_ADMIN_EMAIL=admin@local.test
DEV_ADMIN_NAME=Development administrator
DEV_ADMIN_PASSWORD=dev-admin-password

# --- FreeSWITCH (S1-10) ----------------------------------------------------
# Not published to the host — see docker-compose.yml. Kept as its own var
# because vars.xml's internal profile still binds to it.
FS_SIP_PORT=5060
# Each node's identity; must match the id half of call-control's FS_NODES.
FS_NODE_ID=freeswitch
FS_NODE_ID_2=freeswitch-2
# mod_redis (the `limit` backend): the container-internal address.
FS_REDIS_HOST=redis
FS_REDIS_PORT=6379
# The compose network's own subnet — broad on purpose (see docker-compose.yml).
FS_OPENSIPS_CIDR=172.16.0.0/12
FS_CLUSTER_CIDR=172.16.0.0/12
FS_EVENT_SOCKET_PASSWORD=dev-event-socket-password
TELEPHONY_CONFIG_URL=http://telephony-config:8080
FS_XML_CURL_TOKEN=dev-internal-token
# cdr-service's own `mod_json_cdr` ingest gate (S2-18) — same shared-token
# mechanism as FS_XML_CURL_TOKEN, a distinct value for a distinct service.
CDR_SERVICE_URL=http://cdr-service:8080
FS_CDR_INGEST_TOKEN=dev-cdr-ingest-token

# --- OpenSIPs (S1-11) -------------------------------------------------------
OPENSIPS_SIP_PORT=5060
OPENSIPS_MI_PORT=8888
OPENSIPS_LOG_LEVEL=3
# Neutral value shared with FreeSWITCH's own sip_identity (CLAUDE.md rule 1)
# — this is what a phone or trunk sees in the Server/User-Agent headers.
OPENSIPS_IDENTITY=SIP Media Server
# cachedb_redis's own URL syntax (03 §2: affinity leases, D-010) — a cache
# group name, not a path.
OPENSIPS_REDIS_URL=redis:cuc://redis:6379/0
# S1-14 (G-18): the FS node pool, seeded into `dispatcher` set 1 at container
# start (telephony/opensips/seed-dispatcher.py) — comma-separated, one entry
# per node (S2-19 added the second). `route{}` also uses this set
# (`ds_is_in_list("$si", $sp)`) to recognize a request FS itself sent back
# (ext→ext), rather than a registered phone dialing out — a CIDR-based check
# was tried first and does not work on a flat compose network
# (opensips.cfg.template's own comment explains why).
OPENSIPS_FS_DESTINATION=sip:freeswitch:5060,sip:freeswitch-2:5060
# S2-02: uac_registrant's REGISTER-checking timer, in seconds (module
# default 100 with hash_size default 1 means up to ~200s to a first
# REGISTER — fast here so trunk registration is testable without a long wait).
OPENSIPS_REGISTRANT_TIMER_INTERVAL=10
# 07 §5: SIP over TLS. Dev makes a self-signed fallback certificate for these
# names at first start (kept in the opensips-tls volume); real certificates
# reach OpenSIPs from the database (tls_mgm, kept by telephony-config).
OPENSIPS_TLS_ENABLED=true
OPENSIPS_TLS_PORT=5061
OPENSIPS_TLS_CERT_FILE=/etc/opensips/tls/cert.pem
OPENSIPS_TLS_KEY_FILE=/etc/opensips/tls/key.pem
OPENSIPS_TLS_DEV_SELF_SIGNED=true
OPENSIPS_TLS_DEV_NAMES=platform.test,*.platform.test

# --- Phones (pbx-config-service) ---------------------------------------------
# Transports offered to phones, most preferred first. TLS last in dev: its
# certificate is self-signed.
SIP_PUBLIC_TRANSPORTS=udp,tcp,tls
# Where phones fetch their settings (the gateway's address as phones see it),
# and the platform-wide HTTP Basic credential they use.
PROVISIONING_BASE_URL=http://localhost:8080
PROVISIONING_USERNAME=phones
PROVISIONING_PASSWORD=dev-provisioning-password

# G-60: api-gateway signs who is calling; every service behind it verifies with
# the same secret (a real deployment generates its own).
INTERNAL_HEADER_SIGNING_SECRET=dev-internal-header-signing-secret
# The host port the gateway is published on.
GATEWAY_PORT=8080
# Plain HTTP on a laptop: allow provisioning over HTTP and send no HSTS.
REQUIRE_HTTPS_FOR_PROVISIONING=false
HSTS_MAX_AGE_SECONDS=0

# --- Service addresses ------------------------------------------------------
# Inside the compose network; change only to point a service at a copy running
# somewhere else.
ORG_SERVICE_URL=http://org-service:8080
VOICEMAIL_SERVICE_URL=http://voicemail-service:8080
