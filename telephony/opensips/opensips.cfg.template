####### S1-11: OpenSIPs edge (03 §2) #######
#
# Not the stock residential example this image ships — that config assumes
# a single flat user base with no tenancy, no trunks, and no FS cluster.
# Every value that differs per deployment is an environment variable,
# substituted at container start by docker-entrypoint.sh via `envsubst`
# (see the Dockerfile) — there are no per-tenant edits to this file (03 §2).
#
# DB backend: db_mysql against the `opensips` schema (05 §1.1) —
# provisioned by infra/compose/mariadb/init/02-opensips-schema.sh from
# telephony/opensips/db-schema/*.sql, OpenSIPs' own vendored table layouts.
# Only telephony-config (S1-12) ever writes rows there; this proxy only
# reads and caches, reloaded through MI (dr_reload, address_reload,
# domain_reload, ds_reload) once that projection exists.

log_level=${OPENSIPS_LOG_LEVEL}
xlog_level=${OPENSIPS_LOG_LEVEL}
stderror_enabled=yes
syslog_enabled=no

udp_workers=4

# 02 §5.5 — the brand-leak surface for the SIP `Server` and `User-Agent`
# headers this proxy itself adds (distinct from FreeSWITCH's own, S1-10).
server_header="Server: ${OPENSIPS_IDENTITY}"
user_agent_header="User-Agent: ${OPENSIPS_IDENTITY}"

socket=udp:*:${OPENSIPS_SIP_PORT}
socket=tcp:*:${OPENSIPS_SIP_PORT}

# SIP over TLS (07 §5). The entrypoint keeps the lines between the `@if-tls`
# markers only when a certificate is configured, so a deployment without one
# keeps exactly the listeners above.
# @if-tls
socket=tls:*:${OPENSIPS_TLS_PORT}
# @end-tls


####### Modules Section ########

mpath="/usr/lib/x86_64-linux-gnu/opensips/modules/"

#### Core infrastructure — every routing decision below depends on these.
loadmodule "signaling.so"
loadmodule "sl.so"
loadmodule "tm.so"
modparam("tm", "fr_timeout", 5)
modparam("tm", "fr_inv_timeout", 30)

loadmodule "rr.so"
modparam("rr", "append_fromtag", 1)

loadmodule "maxfwd.so"
loadmodule "sipmsgops.so"
loadmodule "proto_udp.so"

# The db_mysql driver every db_url-configured module below needs — loaded
# once, early, rather than once per module.
loadmodule "db_mysql.so"
loadmodule "proto_tcp.so"

# @if-tls
#### TLS transport. A certificate per SIP proxy hostname, from the database, and
#### optionally a file as the fallback (see below and docker-entrypoint.sh).
#### Clients are not asked for a certificate: phones
#### authenticate with a SIP digest over the encrypted connection, as they do
#### over UDP. Older protocol versions and weak ciphers are refused.
loadmodule "tls_openssl.so"
loadmodule "tls_mgm.so"
loadmodule "proto_tls.so"
# The certificates for the SIP proxy hostnames come from the `tls_mgm` table
# (G-105): telephony-config projects each certificate the platform obtains, and
# reloads them with `tls_reload`, so a new or renewed certificate needs no restart.
# A client is given the certificate whose name it asks for (SNI), and the
# `default` row (the platform's own proxy) for a name there is none for.
modparam("tls_mgm", "db_url", "${OPENSIPS_DB_URL}")
# @if-tls-file
# A fallback that is a file: development makes its own, and a deployment can mount
# one, so TLS works before the first certificate has been issued. It is only used
# for a name the database has nothing for, and no `default` row exists.
modparam("tls_mgm", "server_domain", "filedefault")
modparam("tls_mgm", "match_ip_address", "[filedefault]*")
modparam("tls_mgm", "certificate", "[filedefault]${OPENSIPS_TLS_CERT_FILE}")
modparam("tls_mgm", "private_key", "[filedefault]${OPENSIPS_TLS_KEY_FILE}")
modparam("tls_mgm", "tls_method", "[filedefault]SSLv23")
modparam("tls_mgm", "verify_cert", "[filedefault]0")
modparam("tls_mgm", "require_cert", "[filedefault]0")
modparam("tls_mgm", "ciphers_list", "[filedefault]HIGH:!aNULL:!MD5:!RC4:!3DES")
# @end-tls-file
# @end-tls

#### Management Interface over HTTP (03 §2: MI-triggered reloads —
#### dr_reload, address_reload, domain_reload, ds_reload — once
#### telephony-config, S1-12, projects real rows to reload).
loadmodule "httpd.so"
modparam("httpd", "port", ${OPENSIPS_MI_PORT})
loadmodule "mi_http.so"

#### Flood protection (03 §2 / the plan's own S1-11 line names this
#### explicitly). Applied to every UDP/TCP request from a source this proxy
#### does not already trust, before anything else does real work — see
#### route{}'s first block for the exemptions (G-117).
loadmodule "pike.so"
modparam("pike", "sampling_time_unit", 2)
modparam("pike", "reqs_density_per_unit", 30)
modparam("pike", "remove_latency", 120)

#### Per-tenant outbound calls-per-second limiting (S2-05; 07 §6) — distinct
#### from pike above: pike guards against a flood from one *source IP*,
#### this guards against one *tenant* (a compromised phone/extension,
#### calling from a perfectly ordinary IP) placing calls too fast.
loadmodule "ratelimit.so"
modparam("ratelimit", "default_algorithm", "TAILDROP")

#### Multi-domain (03 §2's "multi-domain"): which SIP domains this
#### deployment answers for — one per tenant's primary domain plus one per
#### verified reseller base domain (02 §3), projected by telephony-config.
loadmodule "domain.so"
modparam("domain", "db_url", "${OPENSIPS_DB_URL}")
modparam("domain", "db_mode", 1)

#### Inbound trunk identification (03 §1's table: "Owns (permissions
#### address table + registrant contact match)") — matches an inbound
#### trunk's source IP against the address table projected from
#### trunk-service (S2+). Empty today; every trunk check simply misses.
loadmodule "permissions.so"
modparam("permissions", "db_url", "${OPENSIPS_DB_URL}")

#### Registration and digest auth (03 §1: "Owns (registrar, auth_db,
#### usrloc full-sharing cluster)"). calculate_ha1 is off — HA1/HA1B are
#### precomputed by pbx-config-service (S1-09) and stored alongside the
#### tenant's realm, not derived here from a plaintext password OpenSIPs
#### never has.
#
# `use_domain` on both modules (S1-14): without it, `subscriber` and
# `location` are each a *global* username-only namespace, not one per
# tenant domain — confirmed directly, digest auth for a second tenant's
# extension silently fails (or worse, could match a same-numbered
# extension in the wrong tenant) whenever two tenants pick the same
# extension number, which is the normal case (most tenants start
# numbering at 100/101/...), not an edge case. `subscriber`/`location`
# are keyed by (username, domain) precisely so this scoping is possible
# (`telephony/opensips/db-schema/{auth_db,usrloc}-create.sql`).
loadmodule "usrloc.so"
modparam("usrloc", "db_url", "${OPENSIPS_DB_URL}")
modparam("usrloc", "db_mode", 2)
modparam("usrloc", "use_domain", 1)

loadmodule "auth.so"
loadmodule "auth_db.so"
modparam("auth_db", "db_url", "${OPENSIPS_DB_URL}")
modparam("auth_db", "calculate_ha1", 0)
modparam("auth_db", "password_column", "ha1")
modparam("auth_db", "load_credentials", "")
modparam("auth_db", "use_domain", 1)

loadmodule "registrar.so"
modparam("registrar", "tcp_persistent_flag", "TCP_PERSISTENT")

#### Trunk registration and auth for outbound calls (03 §1: "Owns
#### (uac_registrant, clustered)" / "Owns (uac_auth)").
loadmodule "uac.so"
loadmodule "uac_auth.so"
loadmodule "uac_registrant.so"
modparam("uac_registrant", "db_url", "${OPENSIPS_DB_URL}")
# S2-04: answers a carrier's 401/407 challenge on an outbound trunk call.
# `route[outbound_gw]` fills these three AVPs from the selected gateway's
# own `dr_gateways.attrs` (`username:password:host`, projected by
# `opensips-projection.repo.ts`'s `drGatewayAttrsFor`) before every
# `t_relay()` — `uac_auth()` itself (from plain `uac`, not `uac_auth.so`,
# which only holds this shared config) is callable only from a
# `failure_route`.
modparam("uac_auth", "auth_realm_avp", "$avp(auth_realm)")
modparam("uac_auth", "auth_username_avp", "$avp(auth_user)")
modparam("uac_auth", "auth_password_avp", "$avp(auth_pass)")
# Module default is 100s (README.uac_registrant.gz) — with the also-default
# hash_size of 1 (2 buckets), a newly projected registrant can wait up to
# ~2x this value for its first REGISTER. Dev/test wants that fast (S2-02's
# SIPp registrar scenario polls trunk-status); production can override to a
# more conservative value via this same var.
modparam("uac_registrant", "timer_interval", ${OPENSIPS_REGISTRANT_TIMER_INTERVAL})

#### LCR among a tenant's own trunks (03 §1: "Owns (drouting, one rule
#### group per tenant)"), projected from trunk-service's outbound routes.
loadmodule "drouting.so"
modparam("drouting", "db_url", "${OPENSIPS_DB_URL}")
# S2-04: no `dr_groups` row is ever seeded (see `route{}`'s own long
# comment on why), so every `do_routing()` call's own FROM-based
# auto-lookup always misses — without this, an unmatched lookup fails
# outright (`README.drouting`: `default_group`'s own default is "NONE",
# confirmed live). A single shared constant is safe here because real
# tenant isolation lives in the `$rU` prefix tag, not the group id.
modparam("drouting", "default_group", 0)

#### Load balancing across FS nodes (03 §1: "Owns (dispatcher with OPTIONS
#### probing)") — the plan's own "a dispatcher to the FS set".
loadmodule "dispatcher.so"
modparam("dispatcher", "db_url", "${OPENSIPS_DB_URL}")
modparam("dispatcher", "table_name", "dispatcher")
modparam("dispatcher", "ds_ping_interval", 10)
modparam("dispatcher", "ds_probing_mode", 1)

#### Dialog tracking — needed by topology_hiding (below) to persist the
#### hidden-leg mapping across a call.
loadmodule "dialog.so"
modparam("dialog", "db_url", "${OPENSIPS_DB_URL}")
modparam("dialog", "db_mode", 1)

#### Topology hiding (03 §1: "Owns"): applied to every dialog-forming
#### request in route{}, so no internal FS/OpenSIPs topology ever reaches
#### a phone or a trunk.
loadmodule "topology_hiding.so"

#### Signaling NAT (03 §2's own words: "nathelper for signaling
#### (fix_nated_contact, keepalive pinging)").
loadmodule "nathelper.so"
modparam("nathelper", "natping_interval", 30)

#### Presence / BLF (03 §1: "Owns (presence, pua_dialoginfo)"; S2-17).
#### `dialog.so` above already creates a dialog for every dialog-forming
#### request relayed through `topology_hiding()` (its own docs: internally
#### calls `create_dialog()` when none exists yet) — `pua_dialoginfo`
#### registers its own dialog callbacks the moment the module loads, so no
#### extra per-call action is needed in route{} beyond that existing
#### `topology_hiding()` call to get early/confirmed/terminated state
#### changes flowing into `pua`, and from there into `presence`'s own
#### `presentity`/`active_watchers` tables (`db-schema/presence-create.sql`,
#### already provisioned since S1-11). Only the SUBSCRIBE side (route{}'s
#### own `is_method("SUBSCRIBE")` block) is new here — see G-38 for what
#### could not be confirmed against a real running instance.
loadmodule "presence.so"
modparam("presence", "db_url", "${OPENSIPS_DB_URL}")
loadmodule "presence_dialoginfo.so"
loadmodule "pua.so"
modparam("pua", "db_url", "${OPENSIPS_DB_URL}")
loadmodule "pua_dialoginfo.so"

#### Affinity leases (D-010) — read by call-control (S2+), not by
#### anything in this script. Configured here since this is where every
#### other shared resource URL for this node lives.
loadmodule "cachedb_redis.so"
modparam("cachedb_redis", "cachedb_url", "${OPENSIPS_REDIS_URL}")

#### Multi-instance clustering (03 §2) is not loaded: unlike every other
#### db_url-backed module above, clusterer does not degrade to an inert,
#### empty-set state when its table has no rows for this node — confirmed
#### directly ("Current node does not belong to any cluster" is a fatal
#### init error, not a warning). There is no second OpenSIPs instance to
#### cluster with yet (S4's HA work); add this together with the seed row
#### a real cluster config needs.

#### HEP export to Homer (03 §2) is not loaded: proto_hep requires a real
#### `socket=hep_udp:...` listener to even initialize (confirmed directly —
#### loading it with none configured aborts startup), and no capture server
#### exists yet to point one at. Add both together when one does.


####### Routing Logic ########

route{
    # Flood protection (pike) first, for every source except the peers this
    # proxy already trusts (G-117): FreeSWITCH nodes (dispatcher set 1, matched
    # by address and port, exactly as the "request from FS" branch below does)
    # and addresses listed on a trunk (the permissions `address` table, group
    # 1, the same rows that authenticate IP-based trunks). A busy media server
    # or a carrier delivering a burst of calls would otherwise be blocked for
    # `remove_latency` seconds, failing every call through it. Both lookups
    # are in-memory caches, so they cost about as much as pike itself. Phones
    # and unknown sources stay fully protected.
    if (!ds_is_in_list("$si", $sp) && !check_source_address(1)) {
        if (!pike_check_req()) {
            xlog("L_WARN", "pike: blocking flood from $si\n");
            exit;
        }
    }

    if (!mf_process_maxfwd_header(10)) {
        send_reply(483, "Too Many Hops");
        exit;
    }

    # 03 §2: "OpenSIPs strips any inbound X-Tenant-* or X-Trunk-* headers
    # from external sources." Unconditional, before anything below trusts
    # any header this proxy itself did not just set.
    remove_hf("X-Tenant-Id");
    remove_hf("X-Tenant-Domain");
    remove_hf("X-Trunk-Id");
    remove_hf("X-Call-Direction");

    # Answer aliveness/OPTIONS pings addressed to this proxy itself (not a
    # specific user) directly — the same pattern dispatcher's own OPTIONS
    # probing of the FS set relies on in reverse. S1-11's own "Done when":
    # "responds to OPTIONS with a neutral Server header."
    if (is_method("OPTIONS") && !has_totag() && $rU == NULL) {
        sl_send_reply(200, "OK");
        exit;
    }

    # In-dialog request (BYE, re-INVITE, ACK for a non-2xx, ...). Not
    # `loose_route()`: confirmed directly (via the module docs) that
    # `topology_hiding()` above never adds a Record-Route at all — it hides
    # the whole topology by rewriting Contact alone (into the encoded
    # `thinfo=...` form seen on the wire), so there is never a Route header
    # for `loose_route()` to find, and it fails every single in-dialog
    # request. `topology_hiding_match()` is this module's own purpose-built
    # replacement: it decodes the hidden Contact/R-URI pair itself instead
    # of relying on a Route header.
    if (has_totag()) {
        if (is_method("ACK") && t_check_trans()) {
            t_relay();
            exit;
        }
        if (!topology_hiding_match()) {
            send_reply(404, "Not here");
            exit;
        }
        route(relay);
        exit;
    }

    if (is_method("CANCEL")) {
        if (t_check_trans()) {
            t_relay();
        }
        exit;
    }

    t_check_trans();

    if (is_method("REGISTER")) {
        # 03 §1: OpenSIPs owns the registrar; no password auth exists on
        # the FS side (03 §3.1) precisely because this challenge already
        # happened here.
        if (!is_uri_host_local()) {
            send_reply(404, "Not here");
            exit;
        }
        if (!www_authorize("", "subscriber")) {
            www_challenge("", "auth");
            exit;
        }
        if (!save("location")) {
            xlog("L_ERR", "usrloc: failed to save location for $tu\n");
        }
        exit;
    }

    if (is_method("SUBSCRIBE")) {
        # S2-17: extension BLF. Authenticated the same way REGISTER is
        # (phones already hold the same digest credentials) — an
        # unauthenticated SUBSCRIBE would otherwise let anyone watch any
        # extension's call state with no proof of identity at all.
        if (!is_uri_host_local()) {
            send_reply(404, "Not here");
            exit;
        }
        if (!www_authorize("", "subscriber")) {
            www_challenge("", "auth");
            exit;
        }
        # Tenant scoping (CLAUDE.md rule 2's own principle, applied at the
        # SIP edge): the watcher's own domain (From) must match the
        # presentity's domain (R-URI/To) — `handle_subscribe()` itself has
        # no concept of tenancy and would otherwise happily let a phone
        # authenticated in one tenant's domain watch a presentity URI in a
        # different tenant's domain, since `presentity`/`active_watchers`
        # are keyed by (username, domain) with no cross-domain check of
        # their own (`db-schema/presence-create.sql`).
        if ($fd != $td) {
            send_reply(403, "Forbidden");
            exit;
        }
        if (!handle_subscribe()) {
            xlog("L_ERR", "presence: handle_subscribe failed for $ru\n");
        }
        exit;
    }

    # A request FS itself sent back to us (03 §2.1: "request from FS: if
    # destination is a local user -> lookup(location) and relay") — S1-13's
    # ext→ext dialplan bridges the call back to this proxy's own SIP URI
    # (`OPENSIPS_SIP_URI`, telephony-config's config). Checked first, and
    # separately from the trunk/registered-phone block below: the caller's
    # own FROM header still names a local tenant domain on this leg, which
    # would otherwise satisfy `is_from_local()` too and send the call
    # straight back to the FS pool (`ds_select_dst`) instead of resolving
    # the callee's real contact — a routing loop `check_source_address`/
    # `is_from_local()` alone cannot tell apart from a genuine outbound
    # call, since both look identical from the FROM header's domain alone.
    #
    # `ds_is_in_list("$si", $sp)` (not a `$si == <cidr>` check, tried first
    # and confirmed live to be wrong; nor `ds_is_from_list`, its older name —
    # deprecated in favor of this one, and this OpenSIPs build's dispatcher
    # module does not export it at all — confirmed directly): this compose
    # network is one flat bridge subnet, so *every* container's source
    # address — a registered phone's own SIPp container included — matches
    # the same broad CIDR range FS itself is reachable on, making a CIDR
    # check match a phone's own outbound call too and route it as if it
    # came from FS. Matching against the dispatcher set's real, seeded
    # FS-node membership (G-18) instead of a network range is what actually
    # distinguishes the two. The port argument must be unquoted (`$sp`, not
    # `"$sp"`) — confirmed directly that ds_is_in_list's `port` parameter is
    # typed `int`, and quoting it produces a config parse error
    # ("Param [2] expected to be an integer or variable").
    if (ds_is_in_list("$si", $sp)) {
        if (!topology_hiding()) {
            xlog("L_ERR", "topology_hiding failed for $ru (from FS)\n");
            send_reply(500, "Server Internal Error");
            exit;
        }
        fix_nated_contact();
        if (!lookup("location")) {
            # Not a registered local user — S2-04: 03 §2.1's "else ->
            # do_routing(group = tenant's dr group)" branch.
            #
            # **Not `do_routing()`'s own `groupID` param** (tried first,
            # confirmed live to be unusable): that parameter's fixup is
            # compile-time only — passing a runtime pvar there
            # (`$avp(dr_group)`) fails config parsing outright ("Variable in
            # param [1] is not an integer"), even though `README.drouting`
            # documents it as `(int, optional)` with no hint this is
            # compile-time-only. That rules out communicating a per-call
            # tenant group id through this param at all, by any means (an
            # `X-Dr-Group-Id`-style header included) — the param can only
            # ever be a literal or omitted.
            #
            # With the param omitted, `do_routing()` falls back to its own
            # (FROM username, domain) `dr_groups` auto-lookup — rejected
            # for the same reason `opensips-schema.ts`'s own comment gives:
            # the FROM identity on this FS-originated leg is not guaranteed
            # to be a real registered subscriber's own AOR.
            #
            # Instead: tenant isolation moves into `$rU` itself. FS's own
            # outbound dialplan document (`xml.ts`'s
            # `buildOutboundDialplanDocument`) prepends the tenant's own
            # `tenant_dr_groups.dr_group_id`, zero-padded to a fixed
            # `DR_TAG_WIDTH` (`opensips-projection.repo.ts`), to the dialed
            # number *before* FS ever sends this re-INVITE — e.g. tenant 1
            # dialing +14155552671 arrives here as `$rU` =
            # `00000114155552671`. `dr_rules.prefix` for that tenant's own
            # routes carries the exact same tag prefix
            # (`projectOutboundRoute`), so the prefix trie can only ever
            # match *this* tenant's own rules — a different tenant's tag
            # diverges in the first `DR_TAG_WIDTH` digits and can never be a
            # prefix of this `$rU`, the same fixed-width-disambiguation
            # trick `outboundGwid` already uses. `default_group` (modparam,
            # below) is the fallback every call takes, since no `dr_groups`
            # row is ever seeded — a single shared constant is fine
            # precisely because the tag already does the real isolation.
            #
            # No `rule_attrs_pvar` output: strip/prepend now live on the
            # selected *gateway* row (`dr_gateways.strip`/`pri_prefix`,
            # `strip` widened by `DR_TAG_WIDTH` to also eat the tag),
            # applied automatically by `do_routing()`/`use_next_gw()` to
            # `$rU` — nothing left to read back out of the rule itself.
            # `gw_attrs_pvar` (`$avp(gw_attrs)`) carries the selected
            # gateway's own `attrs` column instead — `route[outbound_gw]`'s
            # register-mode credentials, when the trunk has any.
            if (!do_routing(, "F", , , $avp(gw_attrs))) {
                send_reply(404, "Not Found");
                exit;
            }
            route(outbound_gw);
            exit;
        }
        route(relay);
        exit;
    }

    # From here on this is either a trunk (source matched in the address
    # table) or a registered phone in one of our domains — 03 §2.1's
    # routing summary. Both paths are data-driven against
    # telephony-config's projection (S1-12), which is empty until then:
    # every check below simply finds nothing and falls through, which is
    # the correct, honest behavior for an unprovisioned deployment.
    if (check_source_address(1, $avp(trunk_ctx))) {
        # Inbound trunk call (S2-03). `$avp(trunk_ctx)` is the matched
        # `address` row's own `context_info` — the owning trunk's id, hyphens
        # stripped to fit that column's `CHAR(32)` (S2-02's
        # `opensips-projection.repo.ts`, `context-id.ts` on the telephony-config
        # side that reverses it). Tenant identity is deliberately *not*
        # resolved here: unlike `domain`'s `attrs` column (the registered-phone
        # branch below), `address` has no free column left to carry a second
        # value, and telephony-config's own already-projected trunk mirror can
        # answer "which tenant owns this trunk" just as trustworthily as
        # OpenSIPs could — `/fs/dialplan`'s from-trunk lookup (S2-03) does
        # exactly that with the trunk id this header carries.
        append_hf("X-Call-Direction: inbound\r\n");
        append_hf("X-Trunk-Id: $avp(trunk_ctx)\r\n");
    } else if (is_from_local($var(tenant_id))) {
        # Registered phone in a known domain, calling out. `$var(tenant_id)`
        # is the domain row's own `attrs` column (S1-14) — telephony-config
        # is the only writer of that table (05 §1.1), and this is the one
        # link back to its read model OpenSIPs' own script can reach.
        # FS's `/fs/dialplan` (S1-13) trusts this exact header for ext→ext
        # tenant scoping (03 §3.2: "never inferred from the context name").

        # S2-05 (07 §6: "outbound calls-per-second limits, enforced in
        # OpenSIPs (ratelimit)"). One pipe per tenant (`$var(tenant_id)` as
        # the pipe name — `rl_check`'s own sample usage already passes a
        # pvar there, unlike `do_routing()`'s `groupID`, confirmed NOT to
        # accept one, G-28). The threshold itself is a single shared
        # platform-wide constant, not yet `orgs.limits.maxCallsPerSecond` —
        # docs/decisions.md's own gap entry on why.
        if (!rl_check($var(tenant_id), 10, "TAILDROP")) {
            xlog("L_WARN", "ratelimit: tenant $var(tenant_id) exceeded outbound CPS\n");
            send_reply(503, "Service Unavailable");
            exit;
        }

        append_hf("X-Call-Direction: internal\r\n");
        append_hf("X-Tenant-Id: $var(tenant_id)\r\n");
    } else {
        send_reply(403, "Forbidden");
        exit;
    }

    if (!topology_hiding()) {
        xlog("L_ERR", "topology_hiding failed for $ru\n");
        send_reply(500, "Server Internal Error");
        exit;
    }

    fix_nated_contact();

    # 03 §1: "Load balancing across FS nodes — Owns (dispatcher with
    # OPTIONS probing)." The FS set itself is provisioned as environment
    # config (see the Dockerfile), not a projected table — there is
    # exactly one FS group in this stage (S1-10's single node). G-18
    # (docs/decisions.md): nothing seeds that table yet, so this always
    # returns 503 today — a pre-existing S1-11 gap S1-13's own verification
    # surfaced, not one introduced here.
    if (!ds_select_dst(1, 4)) {
        send_reply(503, "Service Unavailable");
        exit;
    }

    route(relay);
    exit;
}

route[relay] {
    if (!t_relay()) {
        send_reply(500, "Internal Error");
    }
    exit;
}

# S2-04: relays an outbound call to the gateway `do_routing()` (or, on
# retry, `use_next_gw()`) just selected, arming trunk credentials first.
# `failure_route[outbound_gw]` is where the actual failover lives — this
# block only ever sends the *first* attempt.
route[outbound_gw] {
    if (!topology_hiding()) {
        xlog("L_ERR", "topology_hiding failed for $ru (outbound trunk)\n");
        send_reply(500, "Server Internal Error");
        exit;
    }
    fix_nated_contact();
    route(outbound_gw_auth);
    t_on_failure("outbound_gw");
    route(relay);
    exit;
}

# Register-mode trunks (S2-02) carry `username:password:host` in the
# selected gateway's own `attrs` column (`drGatewayAttrsFor`,
# `projection.ts`) — IP-auth trunks leave `$avp(gw_attrs)` unset, and
# these three stay unset too, so `uac_auth()` in `failure_route[outbound_gw]`
# never fires a challenge response for them. The trunk's own `host` is
# assumed to double as the realm the carrier's 401/407 will challenge on
# (docs/decisions.md gap: not yet verified against a real carrier).
route[outbound_gw_auth] {
    if ($avp(gw_attrs) != NULL) {
        $avp(auth_user) = $(avp(gw_attrs){s.select,0,:});
        $avp(auth_pass) = $(avp(gw_attrs){s.select,1,:});
        $avp(auth_realm) = $(avp(gw_attrs){s.select,2,:});
    } else {
        $avp(auth_user) = NULL;
        $avp(auth_pass) = NULL;
        $avp(auth_realm) = NULL;
    }
}

failure_route[outbound_gw] {
    # 401/407: answer the carrier's own challenge and retry the *same*
    # gateway — not a failover case, `use_next_gw()` is not involved.
    if (t_check_status("401|407")) {
        if (uac_auth("MD5,MD5-sess")) {
            t_relay();
        }
        exit;
    }

    # Everything else that should trigger failover to the next trunk in
    # this route's priority order (03 §2.1/S2-04's own "Done when": "SIPp
    # confirms failover to the secondary trunk on 503") — a 5xx from the
    # carrier or a transaction timeout (`t_check_status` never matches a
    # local timeout, so that path always reaches here too). A 3xx/4xx
    # other than 401/407 is a carrier-specific rejection (bad number,
    # etc.) that another trunk is no more likely to accept, so those are
    # deliberately left to propagate unhandled instead of also triggering
    # failover.
    if (t_check_status("[5-6][0-9][0-9]") || t_check_status("408")) {
        if (use_next_gw(, $avp(gw_attrs))) {
            route(outbound_gw_auth);
            t_on_failure("outbound_gw");
            t_relay();
        }
        exit;
    }
    exit;
}
