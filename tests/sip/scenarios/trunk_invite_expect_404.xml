<?xml version="1.0" encoding="ISO-8859-1"?>
<!DOCTYPE scenario SYSTEM "sipp.dtd">
<!--
  S2-03: "a DID owned by tenant B that arrives on tenant A's trunk is
  rejected". The source IP here *does* match a known trunk (`X-Call-
  Direction: inbound`/`X-Trunk-Id` are set, `route{}` relays to FS), so this
  reaches `/fs/dialplan` — which finds no DID for that number scoped to the
  trunk's own tenant (`did.repo.ts`'s own comment on why `scoped(ctx)` alone
  gives this for free) and returns the not-found XML document. FreeSWITCH's
  own dialplan-exhaustion behavior for that is a 404, relayed back through
  OpenSIPs unchanged. No ACK/BYE, same reasoning as
  `trunk_invite_expect_403.xml`.

  The leading `<pause>` matches `trunk_invite.xml`'s own — this scenario
  still needs its *own* trunk provisioned (with this container's real IP
  whitelisted) so the call reaches FS's dialplan at all; only the DID lookup
  there is what's meant to fail.

  Unlike `trunk_invite_expect_403.xml`, this call *does* reach FreeSWITCH —
  confirmed live (`-trace_msg`) that FS answers with its own automatic "100
  Trying" the instant it receives any INVITE, before dialplan lookup even
  runs. Without the `optional="true"` `<recv response="100">` below, SIPp
  treats that 100 as a message this scenario never declared, and — also
  confirmed live — responds by CANCELing the call itself, so the real 404
  this test exists to check for is never even sent.
-->
<scenario name="Trunk INVITE to a DID rejected by the dialplan (expect 404)">
  <pause milliseconds="6000"/>

  <send retrans="4000">
    <![CDATA[
      INVITE sip:[field2]@[field1] SIP/2.0
      Via: SIP/2.0/UDP [local_ip]:[local_port];branch=[branch]
      From: <sip:[field0]@[field1]>;tag=[call_number]
      To: <sip:[field2]@[field1]>
      Call-ID: [call_id]
      CSeq: 1 INVITE
      Contact: <sip:[field0]@[local_ip]:[local_port]>
      Max-Forwards: 70
      Content-Type: application/sdp
      Content-Length: [len]

      v=0
      o=- [call_number] [call_number] IN IP4 [local_ip]
      s=-
      c=IN IP4 [local_ip]
      t=0 0
      m=audio [media_port] RTP/AVP 0
      a=rtpmap:0 PCMU/8000
    ]]>
  </send>

  <recv response="100" optional="true">
  </recv>

  <recv response="404">
  </recv>

</scenario>
