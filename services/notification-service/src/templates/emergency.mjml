<mjml>
  <mj-head>
    <mj-title>{{ title }}</mj-title>
    <mj-attributes>
      <mj-all font-family="Helvetica, Arial, sans-serif" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#fafafa" width="560px">
    {{> header}}
    <mj-section background-color="#ffffff" padding="24px">
      <mj-column>
        <mj-text font-size="20px" font-weight="600" color="#b71c1c">Emergency call</mj-text>
        <mj-text font-size="15px" line-height="1.6" color="#424242">
          Someone in your organization dialled an emergency number, and the call was sent to
          emergency services. This email lets people on site know.
        </mj-text>
        <mj-text font-size="15px" line-height="1.6" color="#424242">
          <b>Dialled:</b> {{ dialedNumber }}<br />
          <b>From:</b> {{ caller }}<br />
          <b>At:</b> {{ at }}<br />
        </mj-text>
        {{#if hasLocation}}
        <mj-text font-size="15px" line-height="1.6" color="#424242">
          <b>Location on file:</b> {{ locationLabel }}<br />
          {{#each addressLines}}{{ this }}<br />{{/each}}
        </mj-text>
        {{else}}
        <mj-text font-size="15px" line-height="1.6" color="#424242">
          No location was found for this extension.
        </mj-text>
        {{/if}}
        <mj-button
          href="{{{link}}}"
          background-color="{{primary}}"
          color="{{onPrimary}}"
          border-radius="4px"
          font-size="15px"
          >Open live calls</mj-button
        >
      </mj-column>
    </mj-section>
    {{> footer}}
  </mj-body>
</mjml>
