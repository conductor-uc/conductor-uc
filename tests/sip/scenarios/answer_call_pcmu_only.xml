<?xml version="1.0" encoding="ISO-8859-1"?>
<!DOCTYPE scenario SYSTEM "sipp.dtd">
<!--
  G-134: a phone that speaks only G.711 (PCMU), as many desk phones do. The
  INVITE must offer PCMU, or the call fails here as it would at such a phone;
  it is answered with PCMU alone, and a tone (8 kHz PCMU) is streamed until
  the BYE. Run with `-mp` set apart from the SIP port.
-->
<scenario name="Answer one call with G.711 alone, with media">
  <!-- Whatever else is offered, G.711 must be. -->
  <recv request="INVITE" crlf="true" timeout="60000">
    <action>
      <ereg regexp="a=rtpmap:0 PCMU/8000" search_in="body" check_it="true" assign_to="media"/>
      <!-- SIPp refuses a variable that is set and never read. -->
      <log message="offered [$media]"/>
    </action>
  </recv>

  <send>
    <![CDATA[
      SIP/2.0 180 Ringing
      [last_Via:]
      [last_From:]
      [last_To:];tag=[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:[field0]@[local_ip]:[local_port]>
      Content-Length: 0
    ]]>
  </send>

  <send retrans="500">
    <![CDATA[
      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:];tag=[call_number]
      [last_Call-ID:]
      [last_CSeq:]
      Contact: <sip:[field0]@[local_ip]:[local_port]>
      Content-Type: application/sdp
      Content-Length: [len]

      v=0
      o=- [call_number] [call_number] IN IP4 [local_ip]
      s=-
      c=IN IP4 [local_ip]
      t=0 0
      m=audio [media_port] RTP/AVP 0
      a=rtpmap:0 PCMU/8000
    ]]>
  </send>

  <recv request="ACK" rtd="true" crlf="true">
  </recv>

  <nop>
    <action>
      <exec rtp_stream="/scenarios/media/tone-440hz-1s.pcmu,-1,0"/>
    </action>
  </nop>

  <recv request="BYE" crlf="true" timeout="60000">
  </recv>

  <send>
    <![CDATA[
      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:]
      [last_Call-ID:]
      [last_CSeq:]
      Content-Length: 0
    ]]>
  </send>

</scenario>
