<?xml version="1.0" encoding="ISO-8859-1"?>
<!DOCTYPE scenario SYSTEM "sipp.dtd">
<!--
  S2-20 (G-41, docs/decisions.md): `trunk_invite.xml`'s own INVITE/ACK
  shape verbatim, but never sends its own BYE — waits for FS's own
  unprompted one instead, the same "wait for the far end's own BYE"
  reasoning `uac_call_wrong_pin.xml`/`login_feature_code.xml` already
  establish for a different FS-initiated hangup. `voicemail.lua`'s own
  `leaveMessage` calls `session:hangup()` itself once recording finishes
  (the node uploader delivers the file afterwards, S5-16) — confirmed live this reliably
  happens well before any fixed multi-second hold a caller-side scenario
  might script (SIPp sends no real RTP audio, so FreeSWITCH's own
  silence-based auto-stop on `recordFile` ends the recording almost
  immediately), so a scenario that scripts its own BYE after a fixed pause
  reliably loses the race and aborts on an "unexpected message" — this
  scenario exists so a trunk-originated (un-registered) caller doesn't
  have that problem.

  `[field0]`=caller user (the carrier's own caller-ID), `[field1]`=the
  R-URI/To domain (OpenSIPs' own SIP identity), `[field2]`=the dialed DID,
  in E.164 — same as `trunk_invite.xml`.
-->
<scenario name="Trunk INVITE to a DID, wait for the far end's own BYE">
  <pause milliseconds="6000"/>

  <send retrans="4000">
    <![CDATA[
      INVITE sip:[field2]@[field1] SIP/2.0
      Via: SIP/2.0/UDP [local_ip]:[local_port];branch=[branch]
      From: <sip:[field0]@[field1]>;tag=[call_number]
      To: <sip:[field2]@[field1]>
      Call-ID: [call_id]
      CSeq: 1 INVITE
      Contact: <sip:[field0]@[local_ip]:[local_port]>
      Max-Forwards: 70
      Content-Type: application/sdp
      Content-Length: [len]

      v=0
      o=- [call_number] [call_number] IN IP4 [local_ip]
      s=-
      c=IN IP4 [local_ip]
      t=0 0
      m=audio [media_port] RTP/AVP 0
      a=rtpmap:0 PCMU/8000
    ]]>
  </send>

  <recv response="100" optional="true">
  </recv>

  <recv response="180" optional="true">
  </recv>

  <recv response="200" rtd="true">
    <action>
      <ereg regexp="sip:[^&gt;]*" search_in="hdr" header="Contact:" assign_to="1"/>
    </action>
  </recv>

  <send>
    <![CDATA[
      ACK [$1] SIP/2.0
      [last_Via:]
      From: <sip:[field0]@[field1]>;tag=[call_number]
      [last_To:]
      Call-ID: [call_id]
      CSeq: 1 ACK
      Contact: <sip:[field0]@[local_ip]:[local_port]>
      Max-Forwards: 70
      Content-Length: 0
    ]]>
  </send>

  <recv request="BYE" crlf="true" timeout="20000">
  </recv>

  <send>
    <![CDATA[
      SIP/2.0 200 OK
      [last_Via:]
      [last_From:]
      [last_To:]
      [last_Call-ID:]
      [last_CSeq:]
      Content-Length: 0
    ]]>
  </send>

</scenario>
