<?xml version="1.0" encoding="ISO-8859-1"?>
<!DOCTYPE scenario SYSTEM "sipp.dtd">
<!--
  S1-14: the caller side of "101 calls 102, answered, BYE", reused for two
  other scenarios too — see `src/run-scenario.ts`:
   - Tenant isolation: run two UASs answering "102" (one per tenant, each
     its own real registration) and dial "102" once; only the caller's own
     tenant's UAS may complete. `[field2]` is always the bare number (not a
     tenant-qualified address) — this scenario cannot express "reach tenant
     B's namespace" at all, which is 03 §3.2's own point (`X-Tenant-Id`
     comes from the trusted registration, never the R-URI).
   - Spoofed `X-Tenant-Id` stripped: same dual-UAS setup, but `[extraheader]`
     (a `-key extraheader "X-Tenant-Id: <tenant B's id>"` CLI value,
     defaulting to empty) injects a spoofed header on the INVITE. OpenSIPs
     strips any inbound `X-Tenant-Id` unconditionally before setting its own
     (opensips.cfg.template's `remove_hf` at the top of `route{}`), so the
     assertion is identical to the isolation case: only the caller's own
     tenant's UAS may complete, regardless of what the spoofed header claims.
  `[field0]`=username, `[field1]`=domain, `[field2]`=destination number.

  The INVITE/ACK/BYE below share the REGISTER's own `[call_id]` verbatim, not
  a derived value like `[call_id]-invite` (tried first): confirmed directly
  that SIPp keys its internal per-process call-matching table on whatever
  Call-ID the scenario's first message used, and a later transaction with a
  *different* Call-ID string has its responses silently uncorrelated — they
  still arrive on the wire (visible via `-trace_msg`) but never reach this
  scenario's `<recv>` steps and are not even counted as "unexpected", which
  is what made this so hard to see. Real UAs mint a fresh Call-ID per
  transaction; reusing REGISTER's here is a SIPp-only concession, harmless
  since REGISTER never forms a dialog.
-->
<scenario name="Register, then call and hang up">
  <send retrans="500">
    <![CDATA[
      REGISTER sip:[field1] SIP/2.0
      Via: SIP/2.0/UDP [local_ip]:[local_port];branch=[branch]
      From: <sip:[field0]@[field1]>;tag=[call_number]
      To: <sip:[field0]@[field1]>
      Call-ID: [call_id]
      CSeq: 1 REGISTER
      Contact: <sip:[field0]@[local_ip]:[local_port]>
      Max-Forwards: 70
      Expires: 300
      Content-Length: 0
    ]]>
  </send>

  <recv response="401" auth="true">
  </recv>

  <send retrans="500">
    <![CDATA[
      REGISTER sip:[field1] SIP/2.0
      Via: SIP/2.0/UDP [local_ip]:[local_port];branch=[branch]
      From: <sip:[field0]@[field1]>;tag=[call_number]
      To: <sip:[field0]@[field1]>
      Call-ID: [call_id]
      CSeq: 2 REGISTER
      Contact: <sip:[field0]@[local_ip]:[local_port]>
      Max-Forwards: 70
      Expires: 300
      [authentication]
      Content-Length: 0
    ]]>
  </send>

  <recv response="200" crlf="true">
  </recv>

  <send retrans="4000">
    <![CDATA[
      INVITE sip:[field2]@[field1] SIP/2.0
      Via: SIP/2.0/UDP [local_ip]:[local_port];branch=[branch]
      From: <sip:[field0]@[field1]>;tag=[call_number]
      To: <sip:[field2]@[field1]>
      Call-ID: [call_id]
      CSeq: 1 INVITE
      Contact: <sip:[field0]@[local_ip]:[local_port]>
      Max-Forwards: 70
      [extraheader]
      Content-Type: application/sdp
      Content-Length: [len]

      v=0
      o=- [call_number] [call_number] IN IP4 [local_ip]
      s=-
      c=IN IP4 [local_ip]
      t=0 0
      m=audio [media_port] RTP/AVP 0
      a=rtpmap:0 PCMU/8000
    ]]>
  </send>

  <recv response="100" optional="true">
  </recv>

  <recv response="180" optional="true">
  </recv>

  <!-- OpenSIPs' `topology_hiding()` (opensips.cfg.template) hides the whole
       topology by rewriting Contact alone — confirmed directly (module
       docs) it never adds a Record-Route, so there is no Route header for
       SIPp's own `[routes]` keyword to build (tried first: with no
       Record-Route ever seen, it expands to nothing, and an empty line in
       its place ends the SIP header section early per RFC 3261 — the exact
       same blank-line-terminates-headers failure `[extraheader]` hit
       above). Per the module's own design, in-dialog requests must target
       the hidden Contact URI itself as the R-URI (`sip:172.18.0.8;thinfo=`
       ..., not the original `[field2]@[field1]`) — that's what carries the
       encoded routing state `topology_hiding_match()` decodes on the way
       back in. -->
  <recv response="200" rtd="true">
    <action>
      <ereg regexp="sip:[^&gt;]*" search_in="hdr" header="Contact:" assign_to="1"/>
    </action>
  </recv>

  <send>
    <![CDATA[
      ACK [$1] SIP/2.0
      [last_Via:]
      From: <sip:[field0]@[field1]>;tag=[call_number]
      [last_To:]
      Call-ID: [call_id]
      CSeq: 1 ACK
      Contact: <sip:[field0]@[local_ip]:[local_port]>
      Max-Forwards: 70
      Content-Length: 0
    ]]>
  </send>

  <pause milliseconds="500"/>

  <send retrans="500">
    <![CDATA[
      BYE [$1] SIP/2.0
      Via: SIP/2.0/UDP [local_ip]:[local_port];branch=[branch]
      From: <sip:[field0]@[field1]>;tag=[call_number]
      [last_To:]
      Call-ID: [call_id]
      CSeq: 2 BYE
      Max-Forwards: 70
      Content-Length: 0
    ]]>
  </send>

  <recv response="200" crlf="true">
  </recv>

</scenario>
