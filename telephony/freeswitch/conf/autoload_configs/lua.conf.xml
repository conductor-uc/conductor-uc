<configuration name="lua.conf" description="mod_lua Configuration">
  <!-- S2-16: explicit rather than relying on mod_lua's own compiled-in
       default — the same "make the FS-side path explicit rather than
       assumed" discipline this repo already applies to every other
       autoload config (e.g. xml_curl.conf.xml's gateway-url values). The
       Dockerfile copies telephony/freeswitch/scripts/ to exactly this path. -->
  <settings>
    <param name="script-path" value="/etc/freeswitch/scripts"/>
  </settings>
</configuration>
