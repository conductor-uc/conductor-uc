# The stack CI brings up for the `sip` and `chaos` jobs (.github/workflows/ci.yml).
#
# Those jobs run on a self-hosted runner, which can be the machine a developer's
# own stack is on. Under the compose file's fixed project name the two were one
# project: every CI run's `docker compose down -v` removed the dev stack and
# its volumes (2026-09-29 and 2026-09-30). These give CI's stack its own
# project, subnet and host ports, so both can be up at once.
#
# The workflow loads this file into the job's environment, so compose and the
# suite (tests/sip/src/run-scenario.ts reads COMPOSE_PROJECT_NAME, OPENSIPS_VIP
# and OPENSIPS_INTERNAL_VIP) see the same values. To run the suite against
# such a stack by hand: `set -a; . infra/compose/ci.env; set +a` first.
#
# Not separated: the suite's own SIPp containers (`sip-test-*`) have fixed
# names, so a local run of the suite and a CI run still cannot overlap.
COMPOSE_PROJECT_NAME=conductor-uc-ci

# The last /16 of Docker's default pool, the one it hands out last.
CUC_SUBNET=172.31.0.0/16
CUC_DYNAMIC_RANGE=172.31.0.0/17
OPENSIPS_VIP=172.31.255.10
OPENSIPS_1_IP=172.31.255.11
OPENSIPS_2_IP=172.31.255.12
OPENSIPS_INTERNAL_VIP=172.31.255.13

# Host ports: the dev stack's, plus 10000.
MARIADB_PORT=13306
REDIS_PORT=16379
NATS_PORT=14222
NATS_MONITOR_PORT=18222
PROMETHEUS_PORT=19090
MINIO_API_PORT=19000
MINIO_CONSOLE_PORT=19001
MAILPIT_SMTP_PORT=11025
MAILPIT_UI_PORT=18025
OPENSIPS_HOST_SIP_PORT=15060
OPENSIPS_TLS_PORT=15061
GATEWAY_PORT=18080

# The suite's long-lived curl container (tests/sip/src/global-setup.ts).
SIP_TEST_CURL_CONTAINER=sip-test-ci-curl
